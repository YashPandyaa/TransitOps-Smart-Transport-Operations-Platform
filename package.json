{
  "name": "transitops",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "build": "npm --prefix backend run build && npm --prefix frontend run build",
    "start": "node --enable-source-maps backend/src/index.js",
    "lint": "echo \"(optional) add eslint\""
  },
  "devDependencies": {
    "concurrently": "^9.0.0"
  }
}

